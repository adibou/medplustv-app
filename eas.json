{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_TV": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
    "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_TV": "1"
      }    
    }
  },
  "submit": {
    "production": {"android": {
        "track": "internal"
      }}
  }
}
