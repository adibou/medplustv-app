{
  "name": "medplustv-app",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --device Television_1080p_API_36",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:tv": "cross-env EXPO_TV=1 expo prebuild --clean",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "gcloud:auth": "gcloud auth application-default login --impersonate-service-account=dawi-dev-runtime@dawi-dev-490617.iam.gserviceaccount.com",
    "boot": "& \"$env:LOCALAPPDATA\\Android\\Sdk\\emulator\\emulator.exe\" -avd Television_1080p_API_36 -no-snapshot-load -no-boot-anim"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "~55.0.28",
    "expo-application": "~55.0.17",
    "expo-device": "~55.0.19",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.16",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.26",
    "expo-video": "~55.0.19",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83-stable",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2"
  },
